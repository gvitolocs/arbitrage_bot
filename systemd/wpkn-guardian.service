[Unit]
Description=wPKN Liquidity Guardian Bot
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/wpkn-guardian
EnvironmentFile=/opt/wpkn-guardian/.env
ExecStart=/usr/bin/node /opt/wpkn-guardian/dist/index.js
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wpkn-guardian

# Resource limits for small VPS
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
