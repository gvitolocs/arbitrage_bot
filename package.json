{
  "name": "wpkn-liquidity-guardian",
  "version": "0.1.0",
  "description": "wPKN liquidity guardian and arbitrage monitor for BNB Smart Chain",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/db/schema.sql dist/db/",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "add-v4-lp": "node scripts/add-v4-liquidity.mjs",
    "debug-v4-buy": "npm run build && node scripts/debug-v4-buy.mjs",
    "debug-v4-sell": "npm run build && node scripts/debug-v4-sell.mjs",
    "check-v4-pool": "node scripts/check-v4-pool.mjs"
  },
  "dependencies": {
    "@uniswap/sdk-core": "^7.16.1",
    "@uniswap/universal-router-sdk": "^5.5.1",
    "@uniswap/v4-sdk": "^2.2.1",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
