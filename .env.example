# BNB Smart Chain RPC (comma-separated fallback)
RPC_URLS=https://bsc-dataseed.binance.org/,https://bsc-dataseed1.binance.org/
CHAIN_ID=56

# Dedicated bot hot wallet — NEVER use treasury/main wallet
PRIVATE_KEY=
BOT_WALLET_ADDRESS=

# Comma-separated treasury addresses — bot refuses if BOT_WALLET matches
TREASURY_ADDRESSES=

# Token & router (fill with your deployed addresses)
WPKN_ADDRESS=0x0000000000000000000000000000000000000000
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# PancakeSwap V2 style pair addresses
POOL_A_ADDRESS=0x0000000000000000000000000000000000000000
POOL_A_NAME=wPKN/WBNB
POOL_A_FEE_BPS=25

POOL_B_ADDRESS=0x0000000000000000000000000000000000000000
POOL_B_NAME=wPKN/BNB
POOL_B_FEE_BPS=25

# Safety defaults — keep monitoring-only until reviewed
DRY_RUN=true
ENABLE_TRADING=false
ENABLE_AUTO_LIQUIDITY=false
REQUIRE_MANUAL_CONFIRMATION=true
UNLIMITED_APPROVAL=false

MIN_WPKN_RESERVE_PER_POOL=50
PRICE_DIFF_ALERT_PERCENT=10
ARBITRAGE_MIN_PROFIT_BNB=0.001
MAX_SLIPPAGE_BPS=100
POOL_FEE_BPS=25

MAX_GAS_PRICE_GWEI=3
POLL_INTERVAL_SECONDS=30
MIN_SECONDS_BETWEEN_ACTIONS=300
STALE_POOL_SECONDS=3600

MAX_WPKN_REFILL_PER_TX=50
MAX_WPKN_REFILL_PER_DAY=200
MAX_WBNB_SPEND_PER_TX=0.01
MAX_WBNB_SPEND_PER_DAY=0.05

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_PATH=./data/bot.sqlite
HEALTH_PORT=8080
LOG_LEVEL=info
NODE_ENV=production
