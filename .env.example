# Public RPCs — reads only (reserves, gas, simulation)
RPC_URLS=https://bsc-dataseed.binance.org/,https://bsc-dataseed1.binance.org/

# Free MEV-protected RPCs — broadcast swaps only (BNB Chain + PancakeSwap MEV Guard)
MEV_PROTECT_TX=true
TX_RPC_URLS=https://bscrpc.pancakeswap.finance,https://rpc-bsc.48.club,https://bsc.merkle.io
TX_JITTER_MS=3000

CHAIN_ID=56

PRIVATE_KEY=
BOT_WALLET_ADDRESS=
TREASURY_ADDRESSES=

WPKN_ADDRESS=0x91A17E2bddfF839078BD395482B38e4AC15276f4
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E

# PancakeSwap V2 pair
POOL_A_ADDRESS=0x86294c008542c2707b9f67e3e4ba2d03b7bf7451
POOL_A_NAME=wPKN/WBNB
POOL_A_KIND=v2
POOL_A_FEE_BPS=25

# Uniswap v4 wPKN/BNB 1% — price via Gecko; sells via Universal Router when expensive
POOL_B_ADDRESS=0xce826fc29e6c3d5ffbf30ab4ed68bcd6de43e237ad6485e3f0d76b4075c810bf
POOL_B_NAME=wPKN/BNB
POOL_B_KIND=v4
# BSC Universal Router V2.1.1 (not Polygon 0x1095692…)
UNISWAP_UNIVERSAL_ROUTER=0x8B844f885672f333Bc0042cB669255f93a4C1E6b
UNISWAP_STATE_VIEW=0xd13dd3d6e93f276fafc9db9e6bb47c1180aee0c4
MIN_V4_POOL_RESERVE_USD=25
V4_SELL_WPKN_THIN_POOL=0.25

DRY_RUN=true
ENABLE_TRADING=false
# Rebalance = sell wPKN only on the expensive venue (receives BNB/WBNB). BNB is for gas only.
SELL_ONLY_WPKN=true
# Must stay false — adding pool liquidity would spend your BNB + wPKN (not arbitrage).
ENABLE_AUTO_LIQUIDITY=false

MIN_WPKN_RESERVE_PER_POOL=50
# Rebalance when gap > TARGET; stop once gap <= TARGET (same price within ~10%)
PRICE_DIFF_ALERT_PERCENT=2
TARGET_PRICE_DIFF_PERCENT=10
MIN_V4_GECKO_TRUST_RESERVE_USD=100
MAX_WPKN_SELL_PER_TX=5
MAX_WPKN_SELL_PER_DAY=50
MAX_SLIPPAGE_BPS=100
MAX_GAS_PRICE_GWEI=5
POLL_INTERVAL_SECONDS=30
MIN_SECONDS_BETWEEN_ACTIONS=300

BNB_USD_FALLBACK=630
MAX_WBNB_SPEND_PER_TX=0.05
MAX_WBNB_SPEND_PER_DAY=0.2

# Flareon on nespc — instant only for txs; daily digest at DIGEST_UTC_HOUR
HERMES_ALERT_URL=http://127.0.0.1:18788
HERMES_ALERT_TOKEN=
DIGEST_UTC_HOUR=9

DATABASE_PATH=./data/bot.sqlite
HEALTH_PORT=8080
